<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nur für eine spätere App-Store-/TestFlight-Version. Der SideStore-Build nutzt SleepSonar.entitlements:
  App Attest ist an Team-ID + Bundle-ID gebunden, SideStore signiert aber mit der Team-ID jeder Apple-ID neu,
  und solche Builds laufen in der Entwicklungsumgebung – der Server könnte das nie bestätigen.
  Dazu im Developer-Portal die Fähigkeit „App Attest“ für de.nikgro.sleepsonar aktivieren und am Server
  APP_ID=<TEAMID>.de.nikgro.sleepsonar und ATTEST=required setzen.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array/>
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
</dict>
</plist>
